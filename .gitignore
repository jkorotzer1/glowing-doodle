node_modules/
.next/
next-env.d.ts
*.log

# Secrets. .env holds ODDS_API_KEY, SUBSTACK_SID and ANTHROPIC_API_KEY.
# Each person running this writes their own into their own .env; the
# committed template is .env.example, which carries the keys but no values.
.env
.env.local
auth/

# Local database. The -shm/-wal sidecars matter: `data/*.db` does NOT match
# them, and the WAL file routinely reaches several MB.
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal
data/cache/

# Diagnostic scrape output -- cached copies of third-party pages and API
# responses, written by scripts/spikes/. Local debugging artifacts, not source,
# and not ours to redistribute.
data/spike-odds/
data/spike-silver/

# Hand-transcribed ELWAY projections. The format template is source; the
# transcribed numbers are Silver Bulletin's paid content.
data/silver/*
!data/silver/TEMPLATE.txt

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Generated snapshot of the probability board, and the standalone pages built
# from it. Same reasoning as data/silver/ above: these embed ELWAY's per-game
# projections for all 256 games, and this repo is public. The template and the
# build script ARE source and stay tracked -- run `node export-grid.mjs &&
# node artifact/build.mjs` to regenerate the pages locally.
grid-data.json
artifact/grid.html
artifact/survivor-odds-board.html
